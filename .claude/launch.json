{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "afrideal-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "afrideal-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3200"],
      "port": 3200,
      "env": { "DB_DRIVER": "json", "CATALOGUE_SOURCE": "json", "PAYMENTS_PROVIDER": "mock" }
    },
    {
      "name": "afrideal-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3400"],
      "port": 3400,
      "env": {
        "DB_DRIVER": "json",
        "CATALOGUE_SOURCE": "json",
        "PAYMENTS_PROVIDER": "mock",
        "CARD_PROVIDER": "mock",
        "STRIPE_SECRET_KEY": "",
        "STRIPE_WEBHOOK_SECRET": "",
        "NEXT_DIST_DIR": ".next-verify"
      }
    },
    {
      "name": "afrideal-demo-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3200"],
      "port": 3200,
      "env": { "DB_DRIVER": "json", "CATALOGUE_SOURCE": "json" }
    }
  ]
}
