# Copy to .env.local.

# Clerk (development instance). `clerk init` writes these; or copy them from
# dashboard.clerk.com → API keys. The secret key never reaches the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/after-sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/after-sign-in

# Catalogue source: "json" reads data/*.json (the default, used by `npm run verify`);
# "sanity" reads products, categories, brands, suppliers and supplier offers from the Studio's dataset.
CATALOGUE_SOURCE=json
NEXT_PUBLIC_SANITY_PROJECT_ID=bly84glb
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed for the app's own catalogue writes (supplier verification etc.). Editor token from sanity.io/manage.
SANITY_API_WRITE_TOKEN=

# Transactional store: "json" reads data/*.json; "postgres" keeps every collection
# Sanity does not own in Neon Postgres (lib/postgres). Tables live in the `afrideal`
# schema. Set up once with `npm run db:migrate` then `npm run db:load`.
DB_DRIVER=json
DATABASE_URL=

# Payments (spec 0003). Until DPO Pay is approved, "mock" routes card and wallet
# orders to a mock provider that confirms through the same signed callback the real
# gateway will use; `npm run verify` needs it. Without it checkout offers bank
# transfer only, which finance marks paid by hand.
PAYMENTS_PROVIDER=mock
# The mock is refused in production builds. CI and `npm run e2e` (both `next start`)
# opt back in with ALLOW_MOCK_PAYMENTS=1. Ignored on Vercel, whatever its value.
# ALLOW_MOCK_PAYMENTS=1
# One signing secret per provider, so a leaked mock secret cannot forge a real
# confirmation. The mock falls back to a dev secret outside deployed sites.
# PAYMENT_SECRET_MOCK=
# PAYMENT_SECRET_DPO_PAY=

# Cards (spec 0010). The card is one method; who takes it is CARD_PROVIDER:
# "stripe" (Stripe Checkout), "mock", or "dpo" (not built yet). Unset, cards
# follow PAYMENTS_PROVIDER: the mock when it is "mock", Stripe otherwise.
# CARD_PROVIDER=stripe with PAYMENTS_PROVIDER=mock puts cards on Stripe and
# keeps the wallets on the mock, which is how `npm run verify` covers both.
# CARD_PROVIDER=stripe
# Test keys only: a live key (sk_live_ / rk_live_) is refused and the card is
# not offered. From dashboard.stripe.com/test/apikeys.
# STRIPE_SECRET_KEY=sk_test_...
# The endpoint's signing secret. Locally, `stripe listen --forward-to
# localhost:3000/api/payments/stripe/webhook` prints one. The card is offered
# only when both are set.
# STRIPE_WEBHOOK_SECRET=whsec_...
